{
  "name": "invoice-claw-backend",
  "version": "0.1.0",
  "description": "Backend API for InvoiceClaw SaaS",
  "main": "build/server.js",
  "scripts": {
    "prepare": "prisma generate",
    "prisma-generate": "prisma generate",
    "generate": "prisma generate",
    "postinstall": "npm run generate",
    "build": "rm -rf build node_modules/.prisma && npx prisma generate --schema=prisma/schema.prisma && tsc",
    "dev": "nodemon src/server.ts",
    "start": "node build/server.js",
    "test": "jest",
    "test:watch": "jest --watch"
  },
  "keywords": [
    "invoice",
    "saas",
    "express",
    "typescript"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@prisma/client": "^5.17.0",
    "@types/bcrypt": "^5.0.0",
    "@types/cors": "^2.8.13",
    "@types/express": "^4.17.17",
    "@types/jsonwebtoken": "^9.0.0",
    "@types/node": "^20.0.0",
    "@types/pdfmake": "^0.2.3",
    "bcrypt": "^5.1.0",
    "cors": "^2.8.5",
    "dotenv": "^16.0.3",
    "express": "^4.18.2",
    "jsonwebtoken": "^9.0.0",
    "pg": "^8.11.0",
    "pdfmake": "^0.2.0",
    "prisma": "^5.17.0",
    "tslib": "^2.6.0"
  },
  "devDependencies": {
    "jest": "^29.5.0",
    "nodemon": "^3.0.1",
    "supertest": "^6.3.3",
    "ts-jest": "^29.1.0",
    "ts-node": "^10.9.1",
    "typescript": "^5.0.0"
  }
}